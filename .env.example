# TDEM Backend Configuration
# Copy this file to .env and update values

# ============================================================
# ENVIRONMENT
# ============================================================

# development | production | staging
ENVIRONMENT=development

# Enable debug mode
DEBUG=true

# ============================================================
# SERVER
# ============================================================

# Server host
HOST=127.0.0.1

# Server port
PORT=8000

# Auto-reload on code changes
RELOAD=true

# ============================================================
# STORAGE (Local Development)
# ============================================================

# Path for encrypted object storage
STORAGE_PATH=./data/storage

# Path for metadata storage
METADATA_PATH=./data/metadata

# ============================================================
# CRYPTO ENGINE
# ============================================================

# Time window for temporal fragments (seconds)
# For testing: 5 seconds
# For production: 300-3600 seconds
CRYPTO_TIME_WINDOW=5

# Seed for temporal fragment generation
# IMPORTANT: Change this in production!
# Must be at least 32 bytes
CRYPTO_KSEED=development-seed-key-32-bytes-minimum

# ============================================================
# AUTHENTICATION - DEVELOPMENT
# ============================================================

# Development user ID
DEVELOPMENT_USER_ID=dev_user_001

# Development user name
DEVELOPMENT_USER_NAME=Developer

# ============================================================
# AUTHENTICATION - PRODUCTION (JWT)
# ============================================================

# JWT secret key
# IMPORTANT: Generate a strong key for production!
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT algorithm
JWT_ALGORITHM=HS256

# Access token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================================
# LOGGING
# ============================================================

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log format string
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ============================================================
# AWS INTEGRATION (Future - Not Yet Implemented)
# ============================================================

# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=tdem-encrypted-objects
# AWS_DYNAMODB_TABLE=tdem-metadata
# AWS_COGNITO_USER_POOL_ID=us-east-1_xxxxx
# AWS_COGNITO_CLIENT_ID=xxxxx
